{
  "title": "Streaming por Tenant",
  "uid": "flink-tenants",
  "tags": ["flink", "streaming", "tenant"],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "tenant",
        "label": "Tenant",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(flink_jobmanager_job_uptime, tenant)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "pipeline",
        "label": "Pipeline",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(flink_jobmanager_job_uptime{tenant=~\"$tenant\"}, pipeline)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Estado atual das transmissoes",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Jobs em execucao",
      "description": "Contagem de jobs reportando uptime. Um numero abaixo do esperado significa job parado ou JobManager fora do ar.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "count(flink_jobmanager_job_uptime{tenant=~\"$tenant\", pipeline=~\"$pipeline\"})",
          "instant": true,
          "legendFormat": "jobs"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "graphMode": "none",
        "textMode": "value",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Restarts (1h)",
      "description": "Reinicios somados no periodo. Valor persistentemente acima de zero indica erro de dados, falta de memoria no TaskManager ou sink indisponivel.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
      "targets": [
        {
          "expr": "sum(increase(flink_jobmanager_job_numRestarts{tenant=~\"$tenant\", pipeline=~\"$pipeline\"}[1h])) or vector(0)",
          "instant": true,
          "legendFormat": "restarts"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "graphMode": "none",
        "textMode": "value",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "#EAB839", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Checkpoints falhos (1h)",
      "description": "Sem checkpoint integro o job nao retoma o estado apos falha, e upgrades com savepoint tambem falham.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 1 },
      "targets": [
        {
          "expr": "sum(increase(flink_jobmanager_job_numberOfFailedCheckpoints{tenant=~\"$tenant\", pipeline=~\"$pipeline\"}[1h])) or vector(0)",
          "instant": true,
          "legendFormat": "falhas"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "graphMode": "none",
        "textMode": "value",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Situacao por job",
      "description": "Uma linha por job. E a visao que responde 'como esta o pipeline X do tenant Y agora'.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "flink_jobmanager_job_uptime{tenant=~\"$tenant\", pipeline=~\"$pipeline\"} / 1000",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "sum by (tenant, pipeline, job_name) (flink_taskmanager_job_task_numRecordsInPerSecond{tenant=~\"$tenant\", pipeline=~\"$pipeline\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": { "byField": "job_name", "mode": "outer" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "namespace": true,
              "pod": true,
              "component": true,
              "endpoint": true,
              "container": true,
              "service": true,
              "tenant 2": true,
              "pipeline 2": true
            },
            "renameByName": {
              "job_name": "Job",
              "tenant 1": "Tenant",
              "pipeline 1": "Pipeline",
              "Value #A": "Uptime (s)",
              "Value #B": "Registros/s"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Uptime (s)" },
            "properties": [{ "id": "unit", "value": "s" }]
          }
        ]
      }
    },
    {
      "type": "row",
      "title": "Vazao e atraso",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "collapsed": false
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Registros por segundo",
      "description": "Vazao de entrada por job. Queda a zero com lag subindo = consumo parado.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "targets": [
        {
          "expr": "sum by (job_name) (flink_taskmanager_job_task_numRecordsInPerSecond{tenant=~\"$tenant\", pipeline=~\"$pipeline\"})",
          "legendFormat": "{{job_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "pointSize": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Consumer lag (Kafka)",
      "description": "Quantas mensagens o job esta atras da producao. Tendencia de alta sustentada exige mais paralelismo. Lacunas na linha sao esperadas: o cliente Kafka reporta NaN quando o consumidor esta ocioso, sem fetch recente -- lacuna significa 'sem trafego', nao 'sem lag'.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "targets": [
        {
          "expr": "max by (job_name) (flink_taskmanager_job_task_operator_KafkaSourceReader_KafkaConsumer_records_lag_max{tenant=~\"$tenant\", pipeline=~\"$pipeline\"})",
          "legendFormat": "{{job_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "pointSize": 8
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 100000 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "row",
      "title": "Saude do estado",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "collapsed": false
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Duracao do ultimo checkpoint",
      "description": "Checkpoint que cresce ate se aproximar do intervalo configurado (60s) indica estado grande demais ou backpressure.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "max by (job_name) (flink_jobmanager_job_lastCheckpointDuration{tenant=~\"$tenant\", pipeline=~\"$pipeline\"})",
          "legendFormat": "{{job_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Backpressure",
      "description": "Fracao das subtasks sob backpressure. Acima de zero de forma sustentada, o gargalo esta a jusante -- tipicamente o sink MongoDB.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "avg by (job_name) (flink_taskmanager_job_task_isBackPressured{tenant=~\"$tenant\", pipeline=~\"$pipeline\"})",
          "legendFormat": "{{job_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    }
  ]
}
